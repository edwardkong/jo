---
// The sketchbook: every built-in drawing at the size it appears on the page, for
// judging the motion and for knowing what size to draw at. Plain on purpose. Not
// linked from the homepage.
import Base from '../layouts/Base.astro';
import { doodleSlots, HEADER_KINDS, ITEM_KINDS, FOOTER_KINDS } from '../doodles';
import HeaderDoodle from '../components/doodles/HeaderDoodle.astro';
import ItemDoodle from '../components/doodles/ItemDoodle.astro';
import FooterDoodle from '../components/doodles/FooterDoodle.astro';
import DoodleSlot from '../components/doodles/DoodleSlot.astro';
import { getSite } from '../lib/site';

const custom = getSite().look.drawings.filter((d) => d.file);
const slotLabel: Record<string, string> = {
  header: 'header icon',
  'item-a': 'post icon, 1st/4th/7th',
  'item-b': 'post icon, 2nd/5th/8th',
  'item-c': 'post icon, 3rd/6th/9th',
  footer: 'footer icon',
};

const headerKinds = HEADER_KINDS.filter((k) => k !== 'none');
const footerKinds = FOOTER_KINDS.filter((k) => k !== 'none');

function size(w: number, h: number): string {
  return `${w} × ${h} css px · draw at ${w * 2} × ${h * 2}`;
}
---
<Base title="icons" description="every built-in icon, at size, for judging the motion">
  <main class="sketchbook">
    <h1>icons</h1>
    <p class="lead">
      Every icon on the site lives in a fixed box. These are the built-in ones at the size
      they appear on the page; pick which to use in Site settings › Look. Each is drawn three
      times and flipped between, so the line shivers; the movements are small and stepped,
      like a flipbook. Your own go in through Look › Custom icons; draw them at twice the
      size shown.
    </p>

    <section class="knobs" aria-label="tuning knobs">
      <label>
        <span>line boil <output id="boil-fps-value">7</output> fps</span>
        <input type="range" min="1" max="12" step="1" value="7" data-knob="boil-fps" />
      </label>
      <label>
        <span>motion <output id="motion-value">1</output></span>
        <input type="range" min="0" max="1" step="0.05" value="1" data-knob="motion" />
      </label>
      <p class="knob-note">
        These only change this page while it is open. To keep a setting, change{' '}
        <code>--boil-fps</code> or <code>--motion</code> at the top of{' '}
        <code>src/styles/doodles.css</code>.
      </p>
    </section>

    <h2>header icon <small>{size(doodleSlots.header.width, doodleSlots.header.height)}</small></h2>
    <ul class="cards">
      {headerKinds.map((kind) => (
        <li class="card">
          <div class="box" style={`width:${doodleSlots.header.width}px;height:${doodleSlots.header.height}px`}>
            <HeaderDoodle kind={kind} builtin />
          </div>
          <p class="label">{kind}</p>
        </li>
      ))}
    </ul>

    <h2>post icons <small>{size(40, 40)} · hover or focus to see the reaction</small></h2>
    <ul class="cards">
      {ITEM_KINDS.map((kind) => (
        <li class="card">
          <div class="box" style="width:40px;height:40px">
            <a class="menu-item" href={`#${kind}`} aria-label={kind}><ItemDoodle kind={kind} builtin /></a>
          </div>
          <p class="label">{kind}</p>
        </li>
      ))}
    </ul>

    <h2>footer icon <small>{size(doodleSlots.footer.width, doodleSlots.footer.height)}</small></h2>
    <ul class="cards">
      {footerKinds.map((kind) => (
        <li class="card">
          <div class="box" style={`width:${doodleSlots.footer.width}px;height:${doodleSlots.footer.height}px`}>
            <FooterDoodle kind={kind} builtin />
          </div>
          <p class="label">{kind}</p>
        </li>
      ))}
    </ul>

    <h2>custom icons <small>uploaded in Site settings › Look › Custom icons; these replace the built-in one in their slot</small></h2>
    {custom.length === 0 ? (
      <p class="lead">none uploaded yet.</p>
    ) : (
      <ul class="cards">
        {custom.map((d) => (
          <li class="card">
            <div class="box" style={`width:${doodleSlots[d.slot].width}px;height:${doodleSlots[d.slot].height}px`}>
              <DoodleSlot name={d.slot} />
            </div>
            <p class="label">{slotLabel[d.slot]}</p>
            <p class="file">{d.file.replace(/^.*\//, '')}</p>
          </li>
        ))}
      </ul>
    )}

    <section class="notes">
      <h2>notes</h2>
      <p>
        If your phone or computer is set to reduce motion, everything here holds still on
        its first frame. The same setting swaps uploaded animated files for their still versions.
      </p>
      <p>
        Hover reactions only happen on devices with a mouse; on a phone, tapping a post
        opens it. Keyboard focus triggers the same reactions everywhere.
      </p>
    </section>
  </main>
</Base>

<script>
  const root = document.documentElement;
  for (const input of document.querySelectorAll<HTMLInputElement>('input[data-knob]')) {
    const knob = input.dataset.knob;
    const out = document.getElementById(`${knob}-value`);
    input.addEventListener('input', () => {
      root.style.setProperty(`--${knob}`, input.value);
      if (out) out.textContent = input.value;
    });
  }
</script>

<style>
  .sketchbook {
    max-width: var(--measure);
    margin: 0 auto;
    padding: 0 var(--gutter);
  }
  h1 {
    font-family: var(--hand);
    font-size: 2.2rem;
  }
  h2 {
    font-family: var(--hand);
    font-size: 1.4rem;
    margin-top: 2.2rem;
  }
  h2 small {
    display: block;
    font-size: 0.95rem;
    color: var(--ink-soft);
    font-weight: normal;
  }
  .lead,
  .knob-note,
  .notes p {
    color: var(--ink-soft);
    line-height: 1.55;
    margin-top: 0.6rem;
  }
  .knobs {
    margin-top: 1.5rem;
    padding: 1rem 1.1rem;
    border: 1px dashed var(--ink-soft);
    border-radius: 4px;
  }
  .knobs label {
    display: block;
    margin-bottom: 0.8rem;
  }
  .knobs span {
    display: block;
    margin-bottom: 0.2rem;
  }
  .knobs input {
    width: min(100%, 18rem);
    accent-color: var(--ink);
  }
  code {
    font-size: 0.85em;
  }
  .cards {
    list-style: none;
    margin: 1rem 0 0;
    padding: 0;
    display: flex;
    flex-wrap: wrap;
    gap: 1.25rem 1.75rem;
    align-items: flex-end;
  }
  .card {
    text-align: center;
  }
  .box {
    border: 1px dashed var(--ink-soft);
    line-height: 0;
  }
  .box .menu-item {
    display: block;
  }
  .label {
    margin-top: 0.35rem;
    font-family: var(--hand);
    font-size: 1.05rem;
  }
  .file {
    font-size: 0.8rem;
    color: var(--ink-soft);
    word-break: break-all;
  }
  .notes {
    margin-top: 2.5rem;
  }
</style>
