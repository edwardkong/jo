---
// Nothing at this address.
import Base from '../layouts/Base.astro';
import { withBase } from '../lib/url';
import { getSite } from '../lib/site';

const { wording } = getSite();
---

<Base title={wording.not_found_tab} description={wording.not_found_title}>
  <section class="gone wrap">
    <h1 class="gone__title">{wording.not_found_title}</h1>
    <p class="gone__note">{wording.not_found_text}</p>
    <p class="gone__back">
      <a class="back-link" href={withBase('')}>{wording.back_link}</a>
    </p>
  </section>
</Base>

<style>
  .gone {
    padding-top: 3rem;
    max-width: 30rem;
  }

  .gone__title {
    font-size: clamp(2.4rem, 1.6rem + 5vw, 3.6rem);
    transform: rotate(-1deg);
    transform-origin: left bottom;
  }

  .gone__note {
    margin-top: 1rem;
    color: var(--ink-soft);
    font-style: italic;
  }

  .gone__back {
    margin-top: 1.75rem;
  }
</style>
