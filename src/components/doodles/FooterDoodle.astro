---
// The quiet drawing at the end of a post. Three built-in kinds, chosen in the CMS:
//   pin   a rolling pin rolls slowly across, leaving crumbs that fade (9 s loop)
//   dots  the crumbs alone, appearing left to right and fading
//   line  a hand-drawn line that draws itself across and starts again
// Decorative. Slot: footer, 240 x 60 (draw at 480 x 120).
import DoodleSlot from './DoodleSlot.astro';
import Boil from './Boil.astro';
import type { FooterKind } from '../../doodles';

interface Props {
  /** Ignore custom overrides (icon sheet). */
  builtin?: boolean;
  kind: Exclude<FooterKind, 'none'>;
}
const { kind, builtin = false } = Astro.props;

const pin = [
  'M -22,22 C -26,22 -26,40 -22,40 C -8,40.5 8,39.5 22,40 C 26,40 26,22 22,22 C 8,21.5 -8,22.5 -22.4,22.2',
  'M -25,28 L -34,28 C -35.5,28 -35.5,34 -34,34 L -25,34',
  'M 25,28 L 34,28 C 35.5,28 35.5,34 34,34 L 25,34',
  'M -10,27 C -4,26.5 2,27.5 8,27',
  'M -14,35 C -6,34.6 0,35.4 6,35',
];
const TRAVEL = { from: -45, to: 285 };
const TAIL = 35;
const REST_X = 200;
const HIDDEN_FRACTION = 0.39;

const crumbs = [
  { x: 30, d: 'M 30,47 L 30.4,47.3' },
  { x: 62, d: 'M 61,49 C 62,47.5 64.5,48.5 63.5,50.5 C 62.5,52 60.5,50.5 61.2,49.3' },
  { x: 88, d: 'M 88,46 L 88.5,46.3' },
  { x: 120, d: 'M 119,50 C 120,48.5 122.5,49.5 121.5,51.5 C 120.5,53 118.5,51.5 119.2,50.3' },
  { x: 150, d: 'M 150,48 L 150.4,48.3' },
  { x: 185, d: 'M 184,47 C 185,45.5 187.5,46.5 186.5,48.5 C 185.5,50 183.5,48.5 184.2,47.3' },
].map((c, i, all) => {
  // pin: dropped when the trailing handle has passed. dots: evenly spaced in time.
  const dropAt =
    kind === 'pin' ? (c.x + TAIL - TRAVEL.from) / (TRAVEL.to - TRAVEL.from) : (i + 1) / (all.length + 2);
  let delay = dropAt - HIDDEN_FRACTION;
  if (delay >= 0) delay -= 1;
  return { ...c, delay: Math.round(delay * 1000) / 1000, ahead: kind === 'pin' && c.x > REST_X - TAIL };
});

// A line across the counter, slightly wavy, drawn in one stroke.
const line = ['M 14,32 C 40,22 62,42 90,31 C 118,20 140,44 168,32 C 194,21 212,38 226,30'];
---
<DoodleSlot name="footer" builtin={builtin}>
  <svg viewBox="0 0 240 60" aria-hidden="true" focusable="false" class:list={['footer', kind]}>
    {(kind === 'pin' || kind === 'dots') &&
      crumbs.map((c) => (
        <g class:list={['crumb', { ahead: c.ahead }]} style={`--delay:${c.delay}`}>
          <Boil paths={[c.d]} amount={0.3} />
        </g>
      ))}
    {kind === 'pin' && (
      <g class="pin"><Boil paths={pin} amount={0.6} /></g>
    )}
    {kind === 'line' && (
      <g class="draw"><Boil paths={line} amount={0.6} /></g>
    )}
  </svg>
</DoodleSlot>

<style>
  .footer {
    --footer-period: calc(9s / max(var(--motion), 0.05));
  }
  .footer.dots,
  .footer.line {
    --footer-period: calc(7s / max(var(--motion), 0.05));
  }

  /* Still frames: pin resting on the right; dots all there; the line complete. */
  .pin {
    transform-box: view-box;
    transform: translateX(200px);
  }
  .crumb.ahead {
    opacity: 0;
  }
  .draw path {
    stroke-dasharray: 260;
    stroke-dashoffset: 0;
  }

  @media (prefers-reduced-motion: no-preference) {
    .pin {
      animation: footer-roll var(--footer-period) steps(36, end) infinite;
    }
    .crumb {
      opacity: 1;
      animation: footer-drop var(--footer-period) steps(1, end) infinite;
      animation-delay: calc(var(--delay) * var(--footer-period));
    }
    .draw path {
      animation: footer-draw var(--footer-period) steps(28, end) infinite;
    }

    @keyframes footer-roll {
      0% { transform: translateX(-45px); }
      100% { transform: translateX(285px); }
    }
    @keyframes footer-drop {
      0% { opacity: 0; }
      39% { opacity: 1; }
      100% { opacity: 1; }
    }
    /* Draws across for most of the loop, rests complete, then starts over. */
    @keyframes footer-draw {
      0% { stroke-dashoffset: 260; }
      70% { stroke-dashoffset: 0; }
      100% { stroke-dashoffset: 0; }
    }
  }
</style>
