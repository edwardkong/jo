---
// The small drawing beside each post. Eight built-in kinds, chosen in the CMS; the
// homepage rotates through the chosen ones. Idle they only boil (slower than the
// others, see doodles.css). While the surrounding <a class="menu-item"> is hovered or
// focus-visible they react: the whisk stirs, the crumbs scatter, the star twinkles, the
// rest give a small nudge. Decorative.
// Slots: item-a / item-b / item-c by position, 40 x 40 (draw at 80 x 80).
import DoodleSlot from './DoodleSlot.astro';
import Boil from './Boil.astro';
import type { ItemKind } from '../../doodles';

interface Props {
  kind: ItemKind;
  /** Which of the three rotating slots this is (1st, 2nd, 3rd item…). */
  slot?: 'a' | 'b' | 'c';
}
const { kind, slot = 'a' } = Astro.props;

// Item lines are finer: the slot is small and they repeat down the page.
const AMOUNT = 0.45;

const whisk = [
  'M 18.5,22 C 18,27 17.8,32 17.5,37',
  'M 21.5,22 C 22,27 22.2,32 22.5,37',
  'M 17.5,37 C 19,38.6 21,38.6 22.5,37',
  'M 16,22 C 18,21 22,21 24,22',
  'M 20,21 C 7,17 6,3 19,3 C 33,3 33,17 20,21',
  'M 20,21 C 12,17 11,5 21,4.5 C 29,4.5 28,17 20,21',
  'M 20,21 C 16,17 16,7 20,6.5 C 24,7 24,17 20,21',
];
const biscuit = [
  'M 8,20 C 8,12 14,8 20,8 Q 22.5,11.5 22,12 Q 19,15 19.5,15.5 Q 23,18 23,18.2 Q 20,22 20.2,22.3 C 17,26 10,26 8,20.6',
  'M 12,15 L 12.5,15.4',
  'M 15.5,20 L 16,20.3',
];
const crumbs = [
  { d: 'M 27,12 C 28,10.5 30.5,11.5 29.5,13.5 C 28.5,15 26.5,13.5 27.2,12.3', dx: 1, dy: -1 },
  { d: 'M 32,20 L 32.4,20.3', dx: 1.5, dy: 0.5 },
  { d: 'M 26,26 C 27,24.5 29,25.5 28.5,27.5 C 27.5,29 25.5,27.5 26.2,26.3', dx: -1, dy: 1 },
  { d: 'M 33,31 L 33.5,31.2', dx: 1, dy: 1 },
  { d: 'M 13,32.5 L 13.4,32.7', dx: -1, dy: 0.5 },
];
const star = [
  'M 20,5 Q 25,18.2 28.8,32 Q 17.5,24.4 5.8,15.6 Q 20,14.6 34.2,15.2 Q 22.4,24.2 11.4,32.2 Q 15.4,19.5 20.6,6.4',
];
const ticks = ['M 34,5 L 36.5,2.5', 'M 5,31.5 L 3,34.5'];

// The plain ones: one or two strokes each.
const simple: Record<'dot' | 'leaf' | 'heart' | 'spiral' | 'arrow', string[]> = {
  dot: [
    'M 20,13 C 24,13 27,16 27,20 C 27,24 24,27 20,27 C 16,27 13,24 13,20 C 13,16 16,13 20.4,13.4',
    'M 18,17 C 22,16 24,20 21,23 C 18,24 16,21 18.4,17.6',
  ],
  leaf: [
    'M 10,30 C 12,16 24,9 32,8 C 32,18 26,30 10.5,30.4',
    'M 11,29 C 18,22 25,15 31,9',
  ],
  heart: ['M 20,33 C 10,25 4,18 7,11 C 10,6 17,7 20,13 C 23,7 30,6 33,11 C 36,18 30,25 20.4,32.6'],
  spiral: [
    'M 20,20 C 22,18 24,20 23,22 C 21,25 16,24 15,20 C 14,15 20,11 25,13 C 31,16 31,25 25,29 C 18,33 8,28 8,19 C 8,9 19,4 28,8',
  ],
  arrow: ['M 7,22 C 15,20 24,21 32,20', 'M 26,14 C 29,17 31,19 33,20 C 30,22 28,24 26,27'],
};
---
<DoodleSlot name={`item-${slot}`}>
  <svg viewBox="0 0 40 40" aria-hidden="true" focusable="false">
    {kind === 'whisk' && (
      <g class="stir"><Boil paths={whisk} amount={AMOUNT} /></g>
    )}
    {kind === 'crumb' && (
      <>
        <Boil paths={biscuit} amount={AMOUNT} />
        {crumbs.map((c, i) => (
          <g class="crumb" style={`--dx:${c.dx}px;--dy:${c.dy}px;--i:${i}`}>
            <Boil paths={[c.d]} amount={0.3} />
          </g>
        ))}
      </>
    )}
    {kind === 'star' && (
      <>
        <g class="twinkle"><Boil paths={star} amount={AMOUNT} /></g>
        {ticks.map((d, i) => (
          <g class={`tick tick-${i + 1}`}><Boil paths={[d]} amount={0.3} /></g>
        ))}
      </>
    )}
    {kind in simple && (
      <g class="nudge"><Boil paths={simple[kind as keyof typeof simple]} amount={AMOUNT} /></g>
    )}
  </svg>
</DoodleSlot>

<style>
  .stir,
  .twinkle,
  .crumb,
  .nudge {
    transform-box: view-box;
  }
  .stir {
    transform-origin: 20px 37px;
  }
  .twinkle,
  .nudge {
    transform-origin: 20px 20px;
  }

  @media (prefers-reduced-motion: no-preference) {
    :global(.menu-item):focus-visible .stir,
    :global(.menu-item):hover .stir {
      animation: item-stir 1.2s steps(1, end) infinite;
    }
    :global(.menu-item):focus-visible .crumb,
    :global(.menu-item):hover .crumb {
      animation: item-scatter 0.7s steps(1, end) infinite;
      animation-delay: calc(var(--i) * -0.14s);
    }
    :global(.menu-item):focus-visible .twinkle,
    :global(.menu-item):hover .twinkle {
      animation: item-twinkle 1.1s steps(1, end) infinite;
    }
    :global(.menu-item):focus-visible .tick,
    :global(.menu-item):hover .tick {
      animation: item-blink 1.1s steps(1, end) infinite;
    }
    :global(.menu-item):focus-visible .tick-2,
    :global(.menu-item):hover .tick-2 {
      animation-delay: -0.55s;
    }
    :global(.menu-item):focus-visible .nudge,
    :global(.menu-item):hover .nudge {
      animation: item-nudge 1.2s steps(1, end) infinite;
    }

    /* Pointer-less devices never hover; the rules above only matter where (hover: hover).
       Astro cannot nest a media query inside :global selectors cleanly, so the hover
       half is neutralised here for touch screens instead. */
    @media (hover: none) {
      :global(.menu-item):hover .stir,
      :global(.menu-item):hover .crumb,
      :global(.menu-item):hover .twinkle,
      :global(.menu-item):hover .tick,
      :global(.menu-item):hover .nudge {
        animation: none;
      }
    }

    @keyframes item-stir {
      0% { transform: rotate(0deg); }
      25% { transform: rotate(calc(7deg * var(--motion))); }
      50% { transform: rotate(0deg); }
      75% { transform: rotate(calc(-7deg * var(--motion))); }
      100% { transform: rotate(0deg); }
    }
    @keyframes item-scatter {
      0% { transform: translate(0, 0); }
      50% { transform: translate(calc(var(--dx) * var(--motion)), calc(var(--dy) * var(--motion))); }
      100% { transform: translate(0, 0); }
    }
    @keyframes item-twinkle {
      0% { transform: scale(1) rotate(0deg); }
      30% { transform: scale(calc(1 + 0.08 * var(--motion))) rotate(calc(6deg * var(--motion))); }
      60% { transform: scale(calc(1 - 0.05 * var(--motion))) rotate(calc(-4deg * var(--motion))); }
      100% { transform: scale(1) rotate(0deg); }
    }
    @keyframes item-blink {
      0% { opacity: 1; }
      50% { opacity: 0; }
      100% { opacity: 1; }
    }
    @keyframes item-nudge {
      0% { transform: rotate(0deg) scale(1); }
      30% { transform: rotate(calc(5deg * var(--motion))) scale(calc(1 + 0.05 * var(--motion))); }
      60% { transform: rotate(calc(-3deg * var(--motion))) scale(1); }
      100% { transform: rotate(0deg) scale(1); }
    }
  }
</style>
