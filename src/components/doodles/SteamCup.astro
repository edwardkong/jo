---
// Header doodle: a cup on a saucer with three wisps of steam that rise and fade on a
// slow stepped loop. Decorative (aria-hidden). Slot: header-steam, 120 x 120.
//
// Stand-in for her drawing. viewBox units = CSS px at 1x, so she draws at 240 x 240.
import DoodleSlot from './DoodleSlot.astro';
import Boil from './Boil.astro';

// The cup, drawn with C curves only (see src/lib/wobble.ts: no arcs).
const cup = [
  // saucer: a wobbly ellipse that does not quite close, and a little foot under it
  'M 100,101 C 100,104.9 82.1,108 60,108 C 37.9,108 20,104.9 20,101 C 20,97.1 37.9,94 60,94 C 82.1,94 100,97.1 99.4,100.3',
  'M 44,108.5 C 47,112 73,112 76,108.5',
  // rim (seen slightly from above) and the coffee line inside it
  'M 86,52 C 86,55 74.4,57.5 60,57.5 C 45.6,57.5 34,55 34,52 C 34,49 45.6,46.5 60,46.5 C 74.4,46.5 86,49 86.6,51.4',
  'M 43,53.5 C 49,56.5 71,56.5 77,53.5',
  // body: one stroke down the left, across the bottom, up the right
  'M 34.5,54 C 36,68 39,82 43,92 C 48,97 72,97 77,92 C 81,82 84,68 85.5,54',
  // handle, two strokes
  'M 84,62 C 103,57 105,84 79,85',
  'M 84.5,68 C 95,66 96,80 81,80',
];

// Steam: each wisp is its own part so it can rise on its own phase.
const wisps = [
  'M 48,42 C 42,36 54,31 48,25 C 43,20 51,16 48,12',
  'M 61,40 C 54,33 68,28 61,21 C 55,15 65,12 61,9',
  'M 73,42 C 68,37 79,32 73,26 C 68,21 76,17 73,13',
];
---
<DoodleSlot name="header-steam">
  <svg viewBox="0 0 120 120" aria-hidden="true" focusable="false">
    {wisps.map((d, i) => (
      <g class={`wisp wisp-${i + 1}`}>
        <Boil paths={[d]} amount={0.7} />
      </g>
    ))}
    <Boil paths={cup} amount={0.7} />
  </svg>
</DoodleSlot>

<style>
  /* Still frame: steam sits where it was drawn, a little faint. */
  .wisp {
    opacity: 0.85;
  }

  @media (prefers-reduced-motion: no-preference) {
    .wisp {
      /* 3.6 s loop, 6 held positions: rises ~10px and fades, then starts again low. */
      animation: cup-steam 3.6s steps(1, end) infinite;
    }
    /* Three wisps at three phases: one low and faint, one bright, one nearly gone. */
    .wisp-1 {
      animation-delay: -1.2s;
    }
    .wisp-3 {
      animation-delay: -2.4s;
    }

    @keyframes cup-steam {
      0% {
        transform: translateY(calc(3px * var(--motion)));
        opacity: 0.3;
      }
      16.66% {
        transform: translateY(calc(1.5px * var(--motion)));
        opacity: 0.7;
      }
      33.33% {
        transform: translateY(0);
        opacity: 1;
      }
      50% {
        transform: translateY(calc(-2.5px * var(--motion)));
        opacity: 0.85;
      }
      66.66% {
        transform: translateY(calc(-5px * var(--motion)));
        opacity: 0.55;
      }
      83.33% {
        transform: translateY(calc(-7.5px * var(--motion)));
        opacity: 0.25;
      }
      100% {
        transform: translateY(calc(-9px * var(--motion)));
        opacity: 0;
      }
    }
  }
</style>
