---
// Fixed-size slot for one doodle. What fills it, in order of preference:
//   1. a drawing uploaded through the CMS (Site settings > Look > Drawings),
//   2. a file named in src/doodles.ts (public/doodles/),
//   3. the inline SVG stand-in passed as a child.
// Animated files (GIF, APNG, WebP) are served untouched; the image optimiser never sees them.
import { doodleSlots, doodleFiles, type DoodleName } from '../../doodles';
import { withBase } from '../../lib/url';
import { getSite } from '../../lib/site';

interface Props {
  name: DoodleName;
  /** Empty string = decorative (hidden from screen readers). */
  alt?: string;
  class?: string;
}
const { name, alt = '', class: className = '' } = Astro.props;
const spec = doodleSlots[name];

// Raw URLs for anything in the uploads folder (Vite copies the bytes as they are).
const uploads = import.meta.glob<string>('/src/assets/uploads/*.{gif,png,apng,webp,svg,jpg,jpeg}', {
  query: '?url',
  import: 'default',
  eager: true,
});
function uploadUrl(path: string): string | undefined {
  const key = path.startsWith('/') ? path : `/${path}`;
  return uploads[key];
}

let animated: string | undefined;
let still: string | undefined;

const fromCms = getSite().look.drawings.find((d) => d.slot === name && d.file);
if (fromCms) {
  animated = uploadUrl(fromCms.file);
  still = fromCms.still ? uploadUrl(fromCms.still) : undefined;
  if (!animated) console.warn(`[doodles] ${name}: "${fromCms.file}" is not in src/assets/uploads; using the stand-in.`);
} else if (doodleFiles[name]) {
  const file = doodleFiles[name]!;
  animated = withBase(`doodles/${file}`);
  still = withBase(`doodles/${file.replace(/(\.[a-z0-9]+)$/i, '-still.png')}`);
}
---
<span
  class:list={['doodle-slot', className]}
  data-doodle={name}
  style={`--slot-w:${spec.width}px;--slot-h:${spec.height}px`}
>
  {animated ? (
    still ? (
      <picture>
        <source srcset={animated} media="(prefers-reduced-motion: no-preference)" />
        <img src={still} width={spec.width} height={spec.height} alt={alt} decoding="async" />
      </picture>
    ) : (
      <img src={animated} width={spec.width} height={spec.height} alt={alt} decoding="async" />
    )
  ) : (
    <slot />
  )}
</span>
