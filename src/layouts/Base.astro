---
// The one page shell. Head, skip link, <main>, footer line.
// Every page (menu, post, 404) renders inside this.
import { Font } from 'astro:assets';
import '../styles/global.css';
import '../styles/doodles.css';
import SiteFooter from '../components/SiteFooter.astro';
import { getSite } from '../lib/site';
import { withBase } from '../lib/url';

interface Props {
  /** Page title; the site name is appended ("menu · Small Hours"). */
  title: string;
  description?: string;
}

const site = getSite();
const { title, description = site.intro } = Astro.props;
const fullTitle = `${title} · ${site.name}`;
const look = site.look;
// Colours from Site settings override the defaults in global.css.
const themeVars = `html:root{--paper:${look.color_background};--paper-deep:${look.color_background_deep};--ink:${look.color_ink};--ink-soft:${look.color_ink_soft};--accent:${look.color_accent};}`;
// An emoji (or a letter or two) as the tab icon, drawn into an SVG on the spot.
const emojiIcon = look.favicon.trim()
  ? `data:image/svg+xml,${encodeURIComponent(`<svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 64 64"><text x="32" y="52" font-size="52" text-anchor="middle">${look.favicon.trim().slice(0, 2)}</text></svg>`)}`
  : withBase('favicon.svg');
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="generator" content={Astro.generator} />
    <title>{fullTitle}</title>
    {description && <meta name="description" content={description} />}
    {site.noindex && <meta name="robots" content="noindex" />}
    <meta name="theme-color" content={look.color_background} />
    <link rel="icon" type="image/svg+xml" href={emojiIcon} />
    {/* Self-hosted fonts (see astro.config.mjs). Preload the faces used above the fold. */}
    <Font cssVariable="--font-hand" preload />
    <Font cssVariable="--font-body" preload={[{ style: 'normal' }]} />
    <style is:inline set:html={themeVars}></style>
  </head>
  <body>
    <a class="skip-link" href="#main">skip to the menu</a>
    <main id="main" tabindex="-1">
      <slot />
    </main>
    <SiteFooter text={site.footer} />
  </body>
</html>

<style>
  main {
    padding-block: 1.5rem 3rem;
  }
  main:focus {
    outline: none;
  }
</style>
